# Local SaaS environment (safe defaults)
APP_ENV=local
APP_NAME=SIAEC_SAAS
APP_URL=http://127.0.0.1:8000
PORTAL_URL=https://siaec.com.co
BRAND_SHORT_NAME=SIAEC
BRAND_FULL_NAME=Sistema Integral de Administracion para Escuelas de Conduccion
BRAND_LOGO_PATH=

# Use a dedicated local database for SaaS
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cea_saas_dev

# Generate a unique value for your environment
SECRET_KEY=change-this-local-secret

# Local frontend URL
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Mailer (use sandbox/testing credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=softwaresiaec@gmail.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_NAME=SIAEC
SMTP_USE_TLS=True
HABEAS_CORREO=softwaresiaec@gmail.com
HABEAS_CONTACTO=+57 300 0000000
HABEAS_RAZON_SOCIAL=SIAEC - Sistema Integral de Administracion para Escuelas de Conduccion
HABEAS_NIT=por-definir
HABEAS_POLITICA_URL=https://siaec.co/politica

# Tenant bootstrap (first tenant for local testing)
DEFAULT_TENANT_SLUG=demo-cea
DEFAULT_TENANT_NAME=SIAEC Demo
TENANT_HEADER_NAME=X-Tenant-Slug
TENANT_STRICT_MODE=True
ALLOW_TENANT_BOOTSTRAP=True
ALLOW_SCHOOL_ONBOARDING=True
SCHOOL_ONBOARDING_KEY=change-this-onboarding-key
ALLOW_PUBLIC_SCHOOL_SIGNUP=True
SAAS_ADMIN_EMAILS=softwaresiaec@gmail.com
SAAS_SUPPORT_ALERT_EMAILS=softwaresiaec@gmail.com

# Integracion consulta por cedula (CoreSoft)
CORESOFT_API_BASE_URL=https://coresoft.solutions/api
CORESOFT_API_KEY=
CORESOFT_TIMEOUT_SECONDS=12
